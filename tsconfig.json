{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2020",
    "outDir": "lib",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "cdk-config.ts"
  ],
  "exclude": [
    "node_modules/**/*",
    "cdk.out/**/*",
    ".vscode/**/*",
    "__tests__/**/*.ts"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}
